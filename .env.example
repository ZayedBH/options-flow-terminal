# Backend
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Database
POSTGRES_USER=options
POSTGRES_PASSWORD=options
POSTGRES_DB=options_terminal
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Data Provider
# Options: yfinance | polygon | tradier | unusual_whales
DATA_PROVIDER=yfinance

# Polygon (optional, real-time tier)
POLYGON_API_KEY=

# Tradier (optional)
TRADIER_API_KEY=

# Unusual Whales (optional, paid)
UNUSUAL_WHALES_API_KEY=

# AI Commentary (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Symbols to poll
SYMBOLS=SPY,QQQ,SPX
FUTURES_SYMBOLS=ES=F,NQ=F

# Polling
CHAIN_POLL_INTERVAL_SECONDS=60
QUOTE_POLL_INTERVAL_SECONDS=10

# Risk-free rate (10Y treasury proxy, used for Greeks)
RISK_FREE_RATE=0.045

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
